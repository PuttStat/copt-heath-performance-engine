{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/release/layout,_N_T_/release/page,_N_T_/release"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/release/__PAGE__",
    "/release",
    "/_index",
    "/_head"
  ]
}